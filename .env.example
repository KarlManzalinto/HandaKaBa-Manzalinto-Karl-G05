# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me
# Controls Django debug pages. Use True while developing, False to see the custom 404/500 pages.
DJANGO_DEBUG=True
# Comma-separated hosts that may serve the site when DEBUG is False.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set True only when the site is served over HTTPS (secure cookies, redirect to HTTPS).
# DJANGO_HTTPS=False
# Set True to run the test suite on an in-memory SQLite database instead of PostgreSQL.
# DJANGO_TEST_SQLITE=True

# Option A: Supabase (or any Postgres) connection string
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Option B: local PostgreSQL
DB_NAME=handakaba
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
